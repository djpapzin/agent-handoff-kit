[Unit]
Description=Agent Handoff Kit synthetic recovery demo
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/agent-handoff-kit
ExecStart=/usr/bin/python3 -m handoff_kit.web --host 127.0.0.1 --port 18880
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
MemoryMax=256M
CPUQuota=50%
TasksMax=32
UMask=0077

[Install]
WantedBy=multi-user.target
