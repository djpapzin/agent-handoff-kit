[Unit]
Description=Free HTTPS demo tunnel for Agent Handoff Kit
After=network-online.target agent-handoff-kit.service
Wants=network-online.target agent-handoff-kit.service

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:18880
Restart=always
RestartSec=10
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
